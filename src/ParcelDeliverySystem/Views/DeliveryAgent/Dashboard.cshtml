@model ParcelDeliverySystem.ViewModels.Dashboard.AgentDashboardViewModel
@{
    ViewData["Title"] = "Delivery Agent Dashboard";
}

<div class="container py-4">
    <!-- Header Hero for Agent -->
    <div class="pds-card p-4 mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #064e3b 0%, #047857 100%); color: white; border-radius: 20px;">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2 small fw-semibold">
                    Delivery Partner Hub &bull; Vehicle: @(Model.Agent.VehicleType ?? "Standard Courier")
                </div>
                <h2 class="fw-bold mb-1">Welcome, @Model.Agent.FullName! 🚚</h2>
                <p class="mb-0 text-white-50">Manage active drop-offs, accept pending pickups, and control your live dispatch availability.</p>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex align-items-center justify-content-md-end gap-2">
                <a asp-action="Profile" class="btn btn-outline-light btn-sm rounded-pill px-3">
                    <i class="bi bi-person-gear me-1"></i> Profile & Vehicle
                </a>
                <div class="d-inline-flex align-items-center gap-2 bg-dark bg-opacity-25 p-2 rounded-pill border border-white-50">
                    <span class="small fw-semibold ps-2">Status:</span>
                    <form asp-action="ToggleAvailability" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <select name="status" class="form-select form-select-sm border-0 fw-bold shadow-none" 
                                onchange="this.form.submit()" style="border-radius: 20px; width: auto; display: inline-block;">
                            <option value="@AgentAvailabilityStatus.Available" selected="@(Model.AvailabilityStatus == AgentAvailabilityStatus.Available)">🟢 Available</option>
                            <option value="@AgentAvailabilityStatus.Busy" selected="@(Model.AvailabilityStatus == AgentAvailabilityStatus.Busy || Model.AvailabilityStatus == AgentAvailabilityStatus.OnDelivery)">🟡 Busy</option>
                            <option value="@AgentAvailabilityStatus.Offline" selected="@(Model.AvailabilityStatus == AgentAvailabilityStatus.Offline)">⚪ Offline</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Agent Telemetry -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon primary">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.ActiveDeliveriesCount</div>
                    <div class="stat-label">Active Drop-offs</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.CompletedTodayCount</div>
                    <div class="stat-label">Delivered Today</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon accent">
                    <i class="bi bi-inboxes-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.AvailablePoolCount</div>
                    <div class="stat-label">Available Requests</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon warning">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Rating.ToString("F1") ★</div>
                    <div class="stat-label">Partner Rating</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Assigned Active Deliveries -->
        <div class="col-lg-8">
            <div class="pds-card shadow-sm mb-4">
                <div class="pds-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-truck text-success"></i>
                        <span>Current Deliveries</span>
                    </div>
                    <a asp-action="MyDeliveries" class="btn btn-pds-outline btn-sm">All Deliveries</a>
                </div>
                <div class="pds-card-body p-0">
                    @if (Model.AssignedDeliveries != null && Model.AssignedDeliveries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Tracking Code</th>
                                        <th>Destination</th>
                                        <th>Recipient</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.AssignedDeliveries)
                                    {
                                        <tr>
                                            <td><span class="tracking-code text-success fw-bold">@p.TrackingId</span></td>
                                            <td><div class="small text-truncate" style="max-width: 200px;">@p.DeliveryAddress.FormattedAddress</div></td>
                                            <td>
                                                <div class="small fw-semibold">@p.RecipientName</div>
                                                <div class="text-muted extra-small" style="font-size: 0.75rem;">@p.RecipientPhone</div>
                                            </td>
                                            <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">@p.Status</span></td>
                                            <td class="text-end">
                                                <a asp-action="ManageDelivery" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success rounded-pill fw-semibold">
                                                    <i class="bi bi-sliders me-1"></i> Manage
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <div class="stat-icon success mx-auto mb-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-check-circle"></i>
                            </div>
                            <h6 class="fw-bold">No Deliveries In Progress</h6>
                            <p class="text-muted small mb-3">You currently have no active deliveries assigned.</p>
                            <a asp-action="AvailableRequests" class="btn btn-success btn-sm">
                                <i class="bi bi-inbox me-1"></i> Browse Available Requests
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Available Requests Pool -->
        <div class="col-lg-4">
            <div class="pds-card shadow-sm mb-4">
                <div class="pds-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt text-primary"></i>
                        <span>Available for Pickup</span>
                    </div>
                    <a asp-action="AvailableRequests" class="btn btn-link btn-sm text-decoration-none p-0">View Pool</a>
                </div>
                <div class="pds-card-body p-3">
                    @if (Model.AvailableRequests != null && Model.AvailableRequests.Any())
                    {
                        @foreach (var req in Model.AvailableRequests.Take(3))
                        {
                            <div class="p-3 mb-2 rounded bg-light border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="tracking-code fw-bold text-dark small">@req.TrackingId</span>
                                    <span class="badge bg-primary small">$@req.Price.ToString("F2")</span>
                                </div>
                                <div class="small text-muted text-truncate mb-1">From: @req.PickupAddress.FormattedAddress</div>
                                <div class="small text-secondary text-truncate">To: @req.DeliveryAddress.FormattedAddress</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small text-center py-3">No pending pickup requests nearby.</div>
                    }
                </div>
            </div>

            <!-- Notifications Feed -->
            <div class="pds-card shadow-sm">
                <div class="pds-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bell text-warning"></i>
                        <span>Agent Alerts</span>
                    </div>
                    <a asp-action="Notifications" class="btn btn-link btn-sm text-decoration-none p-0">All</a>
                </div>
                <div class="pds-card-body p-3">
                    @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
                    {
                        @foreach (var notif in Model.RecentNotifications.Take(3))
                        {
                            <div class="d-flex gap-2 mb-2 pb-2 border-bottom last-border-none">
                                <div class="status-dot available mt-2"></div>
                                <div>
                                    <div class="fw-bold small">@notif.Title</div>
                                    <div class="text-secondary small">@notif.Message</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small text-center py-3">No notifications.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.AssignedDeliveries != null && Model.AssignedDeliveries.Any())
    {
        var firstDelivery = Model.AssignedDeliveries.First();
        <div class="pds-card shadow-sm border-0 mt-4 overflow-hidden" style="border-radius: 16px;">
            <div class="pds-card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-map-fill text-success fs-5"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Active Shipment Navigation Route: <span class="font-monospace text-primary">@firstDelivery.TrackingId</span></h6>
                        <span class="text-muted extra-small">OpenStreetMap & Leaflet Live Dispatch Navigation</span>
                    </div>
                </div>
                <a asp-action="ManageDelivery" asp-route-id="@firstDelivery.Id" class="btn btn-success btn-sm rounded-pill px-3">
                    <i class="bi bi-sliders me-1"></i> Manage Drop-off
                </a>
            </div>
            <div id="agentDashboardMap" style="height: 320px; width: 100%;"></div>
        </div>
    }
</div>

@section Scripts {
    @if (Model.AssignedDeliveries != null && Model.AssignedDeliveries.Any())
    {
        var firstDelivery = Model.AssignedDeliveries.First();
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const pLat = parseFloat('@firstDelivery.PickupLatitude') || 0;
                const pLon = parseFloat('@firstDelivery.PickupLongitude') || 0;
                const dLat = parseFloat('@firstDelivery.DeliveryLatitude') || 0;
                const dLon = parseFloat('@firstDelivery.DeliveryLongitude') || 0;
                const routeGeoJsonStr = @Html.Raw(Json.Serialize(firstDelivery.RouteGeometryJson));

                if (window.ParcelMap) {
                    window.ParcelMap.initRouteMap('agentDashboardMap', pLat, pLon, dLat, dLon, routeGeoJsonStr);
                }
            });
        </script>
    }
}
