@model IReadOnlyList<ParcelDeliverySystem.Models.Entities.Parcel>
@{
    ViewData["Title"] = "My Parcels";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">My Parcel Shipments</h3>
            <p class="text-muted small mb-0">Track and manage all your scheduled, active, and completed deliveries</p>
        </div>
        <a asp-action="Book" class="btn btn-pds-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Book New Parcel
        </a>
    </div>

    <div class="pds-card shadow-sm border-0">
        <div class="pds-card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Tracking Code</th>
                                <th>Origin</th>
                                <th>Destination</th>
                                <th>Recipient</th>
                                <th>Service</th>
                                <th>Status</th>
                                <th>Charge</th>
                                <th>Booked On</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var parcel in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@parcel.TrackingId" class="tracking-code fw-bold text-primary text-decoration-none">
                                            @parcel.TrackingId
                                        </a>
                                    </td>
                                    <td>
                                        <div class="small text-truncate" style="max-width: 160px;">@parcel.PickupAddress.FormattedAddress</div>
                                    </td>
                                    <td>
                                        <div class="small text-truncate" style="max-width: 160px;">@parcel.DeliveryAddress.FormattedAddress</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@parcel.DeliveryAddress.RecipientName</div>
                                        <div class="text-muted extra-small" style="font-size: 0.75rem;">@parcel.DeliveryAddress.PhoneNumber</div>
                                    </td>
                                    <td>
                                        <span class="badge @(parcel.DeliveryType == DeliveryType.Express ? "bg-primary-subtle text-primary" : parcel.DeliveryType == DeliveryType.SameDay ? "bg-success-subtle text-success" : "bg-light text-dark border")">
                                            @parcel.DeliveryType
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = parcel.Status switch
                                            {
                                                ParcelStatus.Booked => "bg-info-subtle text-info border border-info-subtle",
                                                ParcelStatus.PendingPickup => "bg-warning-subtle text-warning border border-warning-subtle",
                                                ParcelStatus.AgentAssigned => "bg-primary-subtle text-primary border border-primary-subtle",
                                                ParcelStatus.PickedUp => "bg-primary-subtle text-primary border border-primary-subtle",
                                                ParcelStatus.InTransit => "bg-primary text-white",
                                                ParcelStatus.OutForDelivery => "bg-warning text-dark fw-bold",
                                                ParcelStatus.Delivered => "bg-success text-white fw-bold",
                                                ParcelStatus.Cancelled => "bg-danger-subtle text-danger border border-danger-subtle",
                                                _ => "bg-secondary text-white"
                                            };
                                        }
                                        <span class="badge rounded-pill @badgeClass">@parcel.Status</span>
                                    </td>
                                    <td class="small fw-bold">$@parcel.DeliveryCharge.ToString("F2")</td>
                                    <td class="small text-muted">@parcel.BookingDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@parcel.TrackingId" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.8rem;">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="stat-icon primary mx-auto mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h5 class="fw-bold">No Parcel Bookings Found</h5>
                    <p class="text-muted small mb-3">You have not booked any shipments yet.</p>
                    <a asp-action="Book" class="btn btn-pds-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Book Your First Parcel
                    </a>
                </div>
            }
        </div>
    </div>
</div>
