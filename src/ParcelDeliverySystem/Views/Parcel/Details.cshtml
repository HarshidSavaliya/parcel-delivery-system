@model ParcelDeliverySystem.ViewModels.Parcels.ParcelDetailsViewModel
@{
    ViewData["Title"] = $"Shipment Details - {Model.Parcel.TrackingId}";
    var p = Model.Parcel;
}


<div class="container py-4">
    
    <!-- Top Action Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="tracking-code fs-4 fw-bold text-primary">@p.TrackingId</span>
                @{
                    var badgeClass = p.Status switch
                    {
                        ParcelStatus.Booked => "bg-info-subtle text-info border border-info-subtle",
                        ParcelStatus.PendingPickup => "bg-warning-subtle text-warning border border-warning-subtle",
                        ParcelStatus.AgentAssigned => "bg-primary-subtle text-primary border border-primary-subtle",
                        ParcelStatus.PickedUp => "bg-primary-subtle text-primary border border-primary-subtle",
                        ParcelStatus.InTransit => "bg-primary text-white",
                        ParcelStatus.OutForDelivery => "bg-warning text-dark fw-bold",
                        ParcelStatus.Delivered => "bg-success text-white fw-bold",
                        ParcelStatus.Cancelled => "bg-danger-subtle text-danger border border-danger-subtle",
                        _ => "bg-secondary text-white"
                    };
                }
                <span class="badge rounded-pill @badgeClass px-3 py-1">@p.Status</span>
            </div>
            <div class="small text-muted">
                Booked on @p.BookingDate.ToString("MMMM dd, yyyy 'at' hh:mm tt UTC") &bull; Service: <strong>@p.DeliveryType</strong>
            </div>
        </div>

        <div class="d-flex gap-2">
            @if (Model.CanCancel)
            {
                <form asp-action="Cancel" asp-route-trackingId="@p.TrackingId" method="post" onsubmit="return confirm('Are you sure you want to cancel this shipment booking?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                        <i class="bi bi-x-circle me-1"></i> Cancel Booking
                    </button>
                </form>
            }
            <button onclick="window.print()" class="btn btn-pds-outline btn-sm rounded-pill">
                <i class="bi bi-printer me-1"></i> Print Receipt
            </button>
            <a asp-action="MyParcels" class="btn btn-pds-primary btn-sm rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> All Parcels
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Map & Addresses -->
        <div class="col-lg-8">
            
            <!-- Leaflet Route Map -->
            <div class="pds-card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                <div class="pds-card-header bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-primary"></i>
                        <span class="fw-bold">Live Waypoint Route Map</span>
                    </div>
                    <span class="badge bg-light text-dark border">@p.Distance.ToString("F1") km &bull; Approx. @p.EstimatedDurationMinutes mins</span>
                </div>
                <div class="pds-card-body p-0">
                    <div id="detailsMap" style="height: 320px; width: 100%; border-radius: 0 0 16px 16px;"></div>
                </div>
            </div>

            <!-- Route Stop Details -->
            <div class="pds-card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                <div class="pds-card-header">
                    <span class="fw-bold">Shipment Locations & Contacts</span>
                </div>
                <div class="pds-card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end-md">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="badge bg-primary p-2 rounded-circle"><i class="bi bi-box-seam"></i></div>
                                <h6 class="fw-bold mb-0">Origin / Pickup Address</h6>
                            </div>
                            <div class="fw-semibold text-dark">@p.PickupAddress.RecipientName</div>
                            <div class="small text-muted mb-2"><i class="bi bi-telephone"></i> @p.PickupAddress.PhoneNumber</div>
                            <div class="small text-secondary">@p.PickupAddress.FormattedAddress</div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="badge bg-success p-2 rounded-circle"><i class="bi bi-geo-alt"></i></div>
                                <h6 class="fw-bold mb-0">Destination / Delivery Address</h6>
                            </div>
                            <div class="fw-semibold text-dark">@p.DeliveryAddress.RecipientName</div>
                            <div class="small text-muted mb-2"><i class="bi bi-telephone"></i> @p.DeliveryAddress.PhoneNumber</div>
                            <div class="small text-secondary">@p.DeliveryAddress.FormattedAddress</div>
                            @if (!string.IsNullOrEmpty(p.RecipientEmail))
                            {
                                <div class="extra-small text-muted mt-1"><i class="bi bi-envelope"></i> @p.RecipientEmail</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Timeline Audit Log -->
            <div class="pds-card shadow-sm border-0" style="border-radius: 16px;">
                <div class="pds-card-header">
                    <span class="fw-bold">Status History & Audit Trail</span>
                </div>
                <div class="pds-card-body p-4">
                    @if (p.StatusHistory != null && p.StatusHistory.Any())
                    {
                        <div class="timeline ps-2">
                            @foreach (var log in p.StatusHistory.OrderByDescending(s => s.Timestamp))
                            {
                                <div class="d-flex gap-3 mb-3 pb-2 border-bottom last-border-none">
                                    <div class="status-dot available mt-1"></div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark">@log.Status</span>
                                            <span class="text-muted extra-small" style="font-size: 0.75rem;">@log.Timestamp.ToString("MMM dd, yyyy 'at' hh:mm tt UTC")</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(log.Location))
                                        {
                                            <div class="small text-muted"><i class="bi bi-geo-alt"></i> @log.Location</div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.Notes))
                                        {
                                            <div class="small text-secondary mt-1">@log.Notes</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">No audit history available.</div>
                    }
                </div>
            </div>

        </div>

        <!-- Right: Specifications & Invoice Summary -->
        <div class="col-lg-4">
            
            <div class="pds-card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                <div class="pds-card-header bg-light">
                    <span class="fw-bold">Package Specifications</span>
                </div>
                <div class="pds-card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Package Type:</span>
                        <span class="fw-semibold small">@p.ParcelType</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Weight:</span>
                        <span class="fw-semibold small">@p.Weight.ToString("F1") kg</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Dimensions:</span>
                        <span class="fw-semibold small">@p.Length &times; @p.Width &times; @p.Height cm</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Estimated Delivery:</span>
                        <span class="fw-bold text-success small">@(p.EstimatedDeliveryTime.HasValue ? p.EstimatedDeliveryTime.Value.ToString("MMM dd, yyyy") : "Standard")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(p.Description))
                    {
                        <hr class="my-2">
                        <div class="small text-muted">Description:</div>
                        <div class="small text-secondary">@p.Description</div>
                    }
                    @if (!string.IsNullOrEmpty(p.SpecialInstructions))
                    {
                        <div class="alert alert-warning py-2 px-3 small mt-3 mb-0" style="border-radius: 10px;">
                            <i class="bi bi-info-circle me-1"></i> <strong>Instructions:</strong> @p.SpecialInstructions
                        </div>
                    }
                </div>
            </div>

            <!-- Billing Summary -->
            <div class="pds-card shadow-sm border-0" style="border-radius: 16px;">
                <div class="pds-card-header bg-light">
                    <span class="fw-bold">Billing & Pricing</span>
                </div>
                <div class="pds-card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Delivery Speed Tier:</span>
                        <span class="fw-bold small">@p.DeliveryType</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Payment Status:</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">@p.PaymentStatus</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-center mb-0">
                        <span class="fw-bold text-dark">Total Delivery Charge:</span>
                        <span class="fs-4 fw-bold text-primary">$@p.DeliveryCharge.ToString("F2")</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pickupLat = parseFloat('@p.PickupLatitude') || 0;
            const pickupLon = parseFloat('@p.PickupLongitude') || 0;
            const deliveryLat = parseFloat('@p.DeliveryLatitude') || 0;
            const deliveryLon = parseFloat('@p.DeliveryLongitude') || 0;
            const geometry = @Html.Raw(string.IsNullOrEmpty(p.RouteGeometryJson) ? "null" : p.RouteGeometryJson);
            const status = '@p.Status.ToString()';

            if (window.ParcelMap) {
                window.ParcelMap.initLiveTrackingMap('detailsMap', pickupLat, pickupLon, deliveryLat, deliveryLon, geometry, status);
            }
        });
    </script>
}
