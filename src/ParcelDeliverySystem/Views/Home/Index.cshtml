@{
    ViewData["Title"] = "Smart Courier & Parcel Delivery System";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fw-semibold">
                    <i class="bi bi-stars me-1"></i> Next-Gen Logistics Powered by ASP.NET Core & MongoDB Atlas
                </div>
                <h1 class="hero-title mb-3">
                    Fast, Reliable & <br />
                    <span class="hero-gradient-text">Intelligent Parcel Delivery</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    Enterprise-grade dispatching system with real-time routing, dynamic agent allocation, address autocomplete, and end-to-end parcel telemetry.
                </p>

                <!-- Quick Tracking Lookup Bar -->
                <div class="pds-card p-2 shadow-lg mb-4" style="border-radius: 16px;">
                    <form asp-controller="Home" asp-action="Track" method="get" class="d-flex flex-column flex-sm-row gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-0 text-primary fs-5 ps-3">
                                <i class="bi bi-upc-scan"></i>
                            </span>
                            <input type="text" name="trackingId" class="form-control border-0 shadow-none ps-2" 
                                   placeholder="Enter Tracking Number (e.g. PDS-2026-XXXXX)..." required />
                        </div>
                        <button type="submit" class="btn btn-pds-primary px-4 py-2 text-nowrap">
                            <i class="bi bi-geo-alt-fill me-1"></i> Track Shipment
                        </button>
                    </form>
                </div>

                <div class="d-flex flex-wrap gap-4 text-secondary small">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>Role-Based Access Control</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>MongoDB Atlas NoSQL</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>Geoapify Maps Ready</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="pds-card p-4 shadow-xl border-0" style="border-radius: 24px; background: linear-gradient(145deg, #ffffff, #f1f5f9);">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="fw-bold text-dark fs-5">Role Portals</span>
                        <span class="badge bg-success text-white py-1 px-2 rounded-pill small">System Active</span>
                    </div>

                    <!-- Customer Portal Box -->
                    <div class="pds-card p-3 mb-3 border-0 bg-white shadow-sm hover-scale">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon primary flex-shrink-0">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">Customer Portal</div>
                                <div class="small text-muted">Book deliveries, view history & saved addresses</div>
                            </div>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill">Enter</a>
                        </div>
                    </div>

                    <!-- Agent Portal Box -->
                    <div class="pds-card p-3 mb-3 border-0 bg-white shadow-sm hover-scale">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon success flex-shrink-0">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">Delivery Agent Hub</div>
                                <div class="small text-muted">Toggle availability, accept orders & update status</div>
                            </div>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-success rounded-pill">Enter</a>
                        </div>
                    </div>

                    <!-- Admin Portal Box -->
                    <div class="pds-card p-3 border-0 bg-white shadow-sm hover-scale">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon warning flex-shrink-0">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">Admin Console</div>
                                <div class="small text-muted">User management, fleet oversight & system telemetry</div>
                            </div>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-warning rounded-pill text-dark">Enter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Grid -->
<section class="py-5">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <h2 class="fw-bold">Enterprise Architectural Foundations</h2>
            <p class="text-secondary">Designed from the ground up following clean architecture and SOLID principles.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="pds-card p-4 h-100">
                    <div class="stat-icon primary mb-3">
                        <i class="bi bi-database-check"></i>
                    </div>
                    <h5 class="fw-bold">Official MongoDB .NET Driver</h5>
                    <p class="text-secondary small mb-0">
                        Zero EF Core overhead. Uses typed BSON documents, asynchronous cursor queries, and automated index creation for extreme scale.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pds-card p-4 h-100">
                    <div class="stat-icon success mb-3">
                        <i class="bi bi-layers-fill"></i>
                    </div>
                    <h5 class="fw-bold">Repository & Service Layer</h5>
                    <p class="text-secondary small mb-0">
                        Strict separation of concerns. Controllers delegate business logic to decoupled services, ensuring testability with xUnit and Moq.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pds-card p-4 h-100">
                    <div class="stat-icon accent mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold">Role-Based Security</h5>
                    <p class="text-secondary small mb-0">
                        Secure cookie authentication with claims, work-factor 12 BCrypt password hashing, and role authorization policies.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
