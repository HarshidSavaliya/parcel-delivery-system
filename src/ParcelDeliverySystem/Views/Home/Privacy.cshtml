@{
    ViewData["Title"] = "Security & Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="pds-card shadow-sm border-0 p-4 p-md-5" style="border-radius: 20px;">
                <div class="badge bg-primary-subtle text-primary border border-primary-subtle mb-3 px-3 py-2 rounded-pill">
                    <i class="bi bi-shield-lock-fill me-1"></i> Data Protection & Compliance
                </div>
                <h2 class="fw-bold mb-3">Privacy Policy & Security Standard</h2>
                <p class="text-muted small mb-4">Last Updated: October 2026 &bull; System Version: Phase 1</p>

                <div class="content text-secondary">
                    <h5 class="fw-bold text-dark mt-4">1. Data Storage & MongoDB Atlas Security</h5>
                    <p>
                        All user profiles, credentials, delivery addresses, and shipment records are stored securely within 
                        <strong>MongoDB Atlas</strong> database clusters. Connections are secured using TLS 1.3 encryption in transit, 
                        and documents are protected at rest.
                    </p>

                    <h5 class="fw-bold text-dark mt-4">2. Password Security</h5>
                    <p>
                        Plain-text passwords are never persisted. Passwords undergo irreversible cryptographic salting and hashing 
                        using <strong>BCrypt</strong> with an optimal work factor of 12.
                    </p>

                    <h5 class="fw-bold text-dark mt-4">3. Role-Based Access Control (RBAC)</h5>
                    <p>
                        Our platform strictly enforces separation of concerns across three roles:
                    </p>
                    <ul>
                        <li><strong>Customer:</strong> Access to personal booking history, address books, and active order tracking.</li>
                        <li><strong>Delivery Agent:</strong> Real-time delivery fulfillment, availability state management, and route navigation.</li>
                        <li><strong>Administrator:</strong> Global system governance, fleet coordination, and user management.</li>
                    </ul>

                    <h5 class="fw-bold text-dark mt-4">4. Geoapify Location Data</h5>
                    <p>
                        Address geocoding and routing services are processed via the Geoapify Location Platform. Coordinates are utilized solely for computing delivery distances, accurate estimated transit times, and map visualization.
                    </p>
                </div>

                <div class="mt-4 pt-3 border-top text-end">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-pds-outline btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
