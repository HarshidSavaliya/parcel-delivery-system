@model ParcelDeliverySystem.ViewModels.Users.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="pds-card shadow-sm border-0" style="border-radius: 16px;">
                <div class="pds-card-body p-4">
                    <div class="text-center mb-4">
                        <div class="brand-icon mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.4rem;">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Update Password</h4>
                        <p class="text-muted small">Ensure your account uses a strong, unique password</p>
                    </div>

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-pds-primary w-100 py-2 fw-bold">
                            <i class="bi bi-shield-lock me-1"></i> Update Password
                        </button>
                        <a asp-action="Profile" class="btn btn-link w-100 text-muted small text-decoration-none mt-2">
                            Cancel and Return to Profile
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
