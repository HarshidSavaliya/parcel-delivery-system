<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Parcel Delivery System</title>
    <meta name="description" content="Next-Generation Enterprise Parcel Delivery & Courier Dispatch System powered by ASP.NET Core & MongoDB Atlas." />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Leaflet.js Free OpenStreetMap CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Custom Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg pds-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <span>Parcel<span style="color: var(--primary);">Delivery</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-dismiss="collapse" data-bs-target="#pdsNavbar" aria-controls="pdsNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>
                
                <div class="collapse navbar-collapse" id="pdsNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house me-1"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tracking" asp-action="Track">
                                    <i class="bi bi-search me-1"></i> Track Parcel
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                    <i class="bi bi-shield-check me-1"></i> Security & Privacy
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="BookParcel">
                                    <i class="bi bi-plus-circle me-1"></i> Book Parcel
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="MyParcels">
                                    <i class="bi bi-box2 me-1"></i> My Parcels
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Addresses">
                                    <i class="bi bi-geo-alt me-1"></i> Saved Addresses
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell me-1"></i> Notifications
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("DeliveryAgent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DeliveryAgent" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Agent Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DeliveryAgent" asp-action="AvailableRequests">
                                    <i class="bi bi-inbox me-1"></i> Available Requests
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DeliveryAgent" asp-action="MyDeliveries">
                                    <i class="bi bi-truck me-1"></i> My Deliveries
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DeliveryAgent" asp-action="Profile">
                                    <i class="bi bi-person-gear me-1"></i> Profile & Vehicle
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell me-1"></i> Notifications
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2-fill me-1"></i> Admin Console
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people me-1"></i> User Directory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Agents">
                                    <i class="bi bi-person-badge me-1"></i> Agents Fleet
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Parcels">
                                    <i class="bi bi-boxes me-1"></i> All Shipments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Reports & Analytics
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell me-1"></i> Notifications
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {
                            <a class="btn btn-pds-outline btn-sm" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-pds-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Get Started
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border-radius: 12px;">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Register">
                                            <i class="bi bi-person me-2 text-primary"></i> Register as Customer
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="RegisterAgent">
                                            <i class="bi bi-bicycle me-2 text-success"></i> Join as Delivery Partner
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Role Badge -->
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge-role badge-role-admin me-1">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Admin
                                </span>
                            }
                            else if (User.IsInRole("DeliveryAgent"))
                            {
                                <span class="badge-role badge-role-agent me-1">
                                    <i class="bi bi-truck me-1"></i> Agent
                                </span>
                            }
                            else
                            {
                                <span class="badge-role badge-role-customer me-1">
                                    <i class="bi bi-person-fill me-1"></i> Customer
                                </span>
                            }

                            <!-- User Account Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2 py-1 px-3" style="border-radius: 20px; background: white;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-6 text-primary"></i>
                                    <span class="fw-semibold">@User.Identity?.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border-radius: 14px; min-width: 220px;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-truncate">@User.Identity?.Name</div>
                                        <div class="small text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-lines-fill me-2 text-primary"></i> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key me-2 text-warning"></i> Change Password
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper">
        <partial name="_NotificationToast" />
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="pds-footer mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                        <span class="fw-bold text-dark">Parcel Delivery System</span>
                        <span class="badge bg-light text-secondary border">v1.4 Phase 4</span>
                    </div>
                    <div class="small text-muted mt-1">
                        Built with ASP.NET Core &bull; MongoDB Atlas &bull; Geoapify &bull; Role-Based Security
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted small me-3">Privacy & Terms</a>
                    <a asp-controller="Home" asp-action="Track" class="text-decoration-none text-muted small me-3">Track Shipment</a>
                    <a href="https://cloud.mongodb.com" target="_blank" class="text-decoration-none text-muted small">MongoDB Atlas</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Leaflet.js Free Mapping Engine & ParcelMap Module -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/parcel-map.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
