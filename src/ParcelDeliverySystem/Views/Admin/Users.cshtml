@model IReadOnlyList<ParcelDeliverySystem.ViewModels.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "Customer Management";
    var search = ViewBag.SearchTerm as string;
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Customer Accounts Directory</h3>
            <p class="text-muted small mb-0">Inspect customer profiles, account activity, and control system authorization access.</p>
        </div>
        <div class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
            @(Model?.Count ?? 0) Customers Registered
        </div>
    </div>

    <!-- Search Form -->
    <div class="pds-card p-3 mb-4 border-0 shadow-sm" style="border-radius: 14px;">
        <form asp-action="Users" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" value="@search" placeholder="Search customers by name, email, or phone number..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Search</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="Users" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>

    <div class="pds-card shadow-sm border-0 overflow-hidden" style="border-radius: 16px;">
        <div class="pds-card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Customer Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Registration Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle" style="width: 36px; height: 36px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: bold;">
                                                @user.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@user.FullName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="small text-muted">@user.Email</span></td>
                                    <td><span class="small font-monospace">@user.PhoneNumber</span></td>
                                    <td><span class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Disabled</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="CustomerDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-eye me-1"></i> Details
                                            </a>
                                            <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="returnAction" value="Users" />
                                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill"
                                                        onclick="return confirm('Are you sure you want to @(user.IsActive ? "deactivate" : "activate") @user.FullName?');">
                                                    @(user.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="avatar-circle mx-auto mb-3" style="width: 50px; height: 50px; background: #f8fafc; color: #64748b; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="fw-bold">No Customers Found</h5>
                    <p class="text-muted small">No customer accounts matched your search criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
