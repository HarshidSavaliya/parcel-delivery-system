@model ParcelDeliverySystem.ViewModels.Admin.ParcelSearchFilterViewModel
@using ParcelDeliverySystem.Models.Enums
@{
    ViewData["Title"] = "Shipment Directory & Multi-Criteria Search";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Global Shipments Directory</h3>
            <p class="text-muted small mb-0">Search, filter, and audit all customer packages across all dispatch hubs and couriers.</p>
        </div>
        <div class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
            @Model.TotalResultsCount Shipments Matching
        </div>
    </div>

    <!-- Multi-Criteria Search and Filter Bar -->
    <div class="pds-card p-4 mb-4 border-0 shadow-sm" style="border-radius: 16px;">
        <form asp-action="Parcels" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label extra-small text-uppercase fw-bold text-muted">Keyword / Tracking ID / Recipient</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" class="form-control" value="@Model.SearchTerm" placeholder="PDS-..., Recipient name, City, Phone..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label extra-small text-uppercase fw-bold text-muted">Status</label>
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var status in Enum.GetValues<ParcelStatus>())
                        {
                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label extra-small text-uppercase fw-bold text-muted">Delivery Tier</label>
                    <select name="DeliveryType" class="form-select">
                        <option value="">All Tiers</option>
                        @foreach (var tier in Enum.GetValues<DeliveryType>())
                        {
                            <option value="@tier" selected="@(Model.DeliveryType == tier)">@tier</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label extra-small text-uppercase fw-bold text-muted">Assigned Courier Agent</label>
                    <select name="AgentId" class="form-select">
                        <option value="">All Courier Partners</option>
                        @foreach (var agent in Model.AgentsList)
                        {
                            <option value="@agent.Id" selected="@(Model.AgentId == agent.Id)">@agent.FullName (@agent.PhoneNumber)</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label extra-small text-uppercase fw-bold text-muted">Date From</label>
                    <input type="date" name="DateFrom" class="form-control" value="@(Model.DateFrom.HasValue ? Model.DateFrom.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label extra-small text-uppercase fw-bold text-muted">Date To</label>
                    <input type="date" name="DateTo" class="form-control" value="@(Model.DateTo.HasValue ? Model.DateTo.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel-fill me-1"></i> Apply Filters
                    </button>
                    <a asp-action="Parcels" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Results Table -->
    <div class="pds-card shadow-sm border-0 overflow-hidden" style="border-radius: 16px;">
        <div class="pds-card-body p-0">
            @if (Model.Parcels.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Tracking Code</th>
                                <th>Origin & Destination</th>
                                <th>Recipient & Phone</th>
                                <th>Specs</th>
                                <th>Fare</th>
                                <th>Status</th>
                                <th>Booked On</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Parcels)
                            {
                                <tr>
                                    <td>
                                        <span class="tracking-code font-monospace fw-bold text-primary">@p.TrackingId</span>
                                        <div class="extra-small text-muted">Tier: @p.DeliveryType</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 180px;">@p.PickupAddress.City &rarr; @p.DeliveryAddress.City</div>
                                        <div class="text-muted extra-small">Distance: @p.Distance.ToString("F1") km</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@p.RecipientName</div>
                                        <div class="text-muted extra-small font-monospace">@p.RecipientPhone</div>
                                    </td>
                                    <td>
                                        <div>@p.Weight.ToString("F1") kg</div>
                                        <div class="text-muted extra-small">@p.ParcelType</div>
                                    </td>
                                    <td><span class="fw-bold text-success">$@p.DeliveryCharge.ToString("F2")</span></td>
                                    <td>
                                        <span class="badge @(p.Status switch {
                                            ParcelStatus.Delivered => "bg-success text-white fw-bold",
                                            ParcelStatus.OutForDelivery => "bg-warning text-dark fw-bold",
                                            ParcelStatus.InTransit => "bg-primary text-white",
                                            ParcelStatus.PickedUp => "bg-primary text-white",
                                            ParcelStatus.Cancelled => "bg-danger-subtle text-danger border border-danger-subtle",
                                            ParcelStatus.DeliveryFailed => "bg-danger text-white",
                                            _ => "bg-info-subtle text-info border border-info-subtle"
                                        }) rounded-pill px-2 py-1">
                                            @p.Status
                                        </span>
                                    </td>
                                    <td class="text-muted">@p.BookingDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <a asp-controller="Tracking" asp-action="Track" asp-route-trackingId="@p.TrackingId" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                            <i class="bi bi-geo-alt me-1"></i> Track
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="avatar-circle mx-auto mb-3" style="width: 50px; height: 50px; background: #f8fafc; color: #64748b; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h5 class="fw-bold">No Shipments Found</h5>
                    <p class="text-muted small">Try adjusting your keyword, date range, or status filters.</p>
                </div>
            }
        </div>
    </div>
</div>
