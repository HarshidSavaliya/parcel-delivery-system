@model IReadOnlyList<ParcelDeliverySystem.Models.Entities.Parcel>
@{
    ViewData["Title"] = "My Parcels";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">My Booked Parcels</h3>
            <p class="text-muted small mb-0">Track and manage all your outbound and delivered shipments</p>
        </div>
        <a asp-action="BookParcel" class="btn btn-pds-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Book New Parcel
        </a>
    </div>

    <div class="pds-card shadow-sm border-0">
        <div class="pds-card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Tracking Code</th>
                                <th>Pickup Address</th>
                                <th>Destination Address</th>
                                <th>Recipient</th>
                                <th>Status</th>
                                <th>Price</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var parcel in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="tracking-code fw-bold text-primary">@parcel.TrackingId</span>
                                    </td>
                                    <td>
                                        <div class="small text-truncate" style="max-width: 180px;">@parcel.PickupAddress.FormattedAddress</div>
                                    </td>
                                    <td>
                                        <div class="small text-truncate" style="max-width: 180px;">@parcel.DeliveryAddress.FormattedAddress</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@parcel.RecipientName</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">@parcel.RecipientPhone</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@parcel.Status</span>
                                    </td>
                                    <td class="small fw-bold">$@parcel.Price.ToString("F2")</td>
                                    <td class="text-end">
                                        <a asp-controller="Home" asp-action="Track" asp-route-trackingId="@parcel.TrackingId" class="btn btn-sm btn-outline-secondary rounded-pill">
                                            <i class="bi bi-geo-alt"></i> Track
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="stat-icon primary mx-auto mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h5 class="fw-bold">No Shipments Found</h5>
                    <p class="text-muted small">You haven't booked any shipments yet.</p>
                </div>
            }
        </div>
    </div>
</div>
