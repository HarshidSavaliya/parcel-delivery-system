@model IReadOnlyList<ParcelDeliverySystem.Models.Entities.Notification>
@{
    ViewData["Title"] = "Customer Notifications";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">Notifications & Activity</h3>
            <p class="text-muted small mb-0">System updates, parcel movements, and dispatch alerts</p>
        </div>
    </div>

    <div class="pds-card shadow-sm border-0">
        <div class="pds-card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var notif in Model)
                    {
                        <div class="list-group-item p-3 d-flex gap-3 align-items-start">
                            <div class="stat-icon primary flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                <i class="bi bi-bell-fill"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold mb-1">@notif.Title</h6>
                                    <span class="text-muted small" style="font-size: 0.8rem;">@notif.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <p class="text-secondary small mb-0">@notif.Message</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="stat-icon warning mx-auto mb-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-bell-slash"></i>
                    </div>
                    <h5 class="fw-bold">No Notifications</h5>
                    <p class="text-muted small">You have no alerts at this time.</p>
                </div>
            }
        </div>
    </div>
</div>
