@model IReadOnlyList<ParcelDeliverySystem.Models.Entities.Address>
@{
    ViewData["Title"] = "My Saved Addresses";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">My Address Book</h3>
            <p class="text-muted small mb-0">Manage frequent pickup and delivery locations for 1-click booking</p>
        </div>
        <a asp-action="CreateAddress" class="btn btn-pds-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Address
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-3">
            @foreach (var addr in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="pds-card p-3 shadow-sm h-100 position-relative @(addr.IsDefault ? "border-primary" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-dark border fw-bold px-2 py-1">@addr.Label</span>
                            @if (addr.IsDefault)
                            {
                                <span class="badge bg-primary text-white">Default</span>
                            }
                        </div>
                        <h6 class="fw-bold mb-1">@addr.RecipientName</h6>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-telephone me-1"></i> @addr.PhoneNumber
                        </div>
                        <div class="small text-secondary mb-3" style="min-height: 40px;">
                            @addr.FormattedAddress
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div>
                                @if (!addr.IsDefault)
                                {
                                    <form asp-action="SetDefaultAddress" asp-route-id="@addr.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-primary p-0 small text-decoration-none">
                                            Make Default
                                        </button>
                                    </form>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="EditAddress" asp-route-id="@addr.Id" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-action="DeleteAddress" asp-route-id="@addr.Id" method="post" onsubmit="return confirm('Are you sure you want to remove this address?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" style="font-size: 0.8rem;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="pds-card text-center p-5 shadow-sm">
            <div class="stat-icon accent mx-auto mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-pin-map fs-2"></i>
            </div>
            <h5 class="fw-bold">No Saved Addresses Found</h5>
            <p class="text-muted small mb-3">Add your home or office address to accelerate booking.</p>
            <a asp-action="CreateAddress" class="btn btn-pds-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Your First Address
            </a>
        </div>
    }
</div>
