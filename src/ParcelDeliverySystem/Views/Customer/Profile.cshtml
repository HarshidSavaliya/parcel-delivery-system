@model ParcelDeliverySystem.ViewModels.Users.UserProfileViewModel
@{
    ViewData["Title"] = "Customer Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="fw-bold mb-1">Customer Profile</h3>
                    <p class="text-muted small mb-0">Manage your contact number, personal details, and account settings</p>
                </div>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-pds-outline btn-sm">
                    <i class="bi bi-key me-1"></i> Change Password
                </a>
            </div>

            <div class="pds-card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                <div class="pds-card-body p-4">
                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Role" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div class="brand-icon" style="width: 60px; height: 60px; font-size: 1.8rem; border-radius: 50%;">
                                <i class="bi bi-person-circle"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">@Model.FullName</h5>
                                <div class="text-muted small">@Model.Email</div>
                                <div class="mt-1">
                                    <span class="badge-role badge-role-customer">Verified Customer</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label small fw-semibold text-secondary">Full Name</label>
                                <input asp-for="FullName" class="form-control" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address (Read-only)</label>
                                <input asp-for="Email" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label small fw-semibold text-secondary">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Customer Since</label>
                                <input class="form-control bg-light" value="@Model.CreatedAt.ToString("MMMM dd, yyyy")" readonly />
                            </div>
                        </div>

                        <div class="text-end mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-pds-primary">
                                <i class="bi bi-save me-1"></i> Update Profile Information
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
