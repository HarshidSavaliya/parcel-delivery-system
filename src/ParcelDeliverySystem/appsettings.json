{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "MongoDB": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ParcelDeliveryDB",
    "UsersCollection": "Users",
    "AddressesCollection": "Addresses",
    "ParcelsCollection": "Parcels",
    "NotificationsCollection": "Notifications",
    "DeliveryRecordsCollection": "DeliveryRecords",
    "AgentAssignmentsCollection": "AgentAssignments"
  },
  "Geoapify": {
    "ApiKey": "YOUR_GEOAPIFY_API_KEY",
    "GeocodeEndpoint": "https://api.geoapify.com/v1/geocode/search",
    "AutocompleteEndpoint": "https://api.geoapify.com/v1/geocode/autocomplete",
    "RoutingEndpoint": "https://api.geoapify.com/v1/routing"
  },
  "DeliveryPricing": {
    "BaseFare": 5.00,
    "RatePerKm": 0.75,
    "RatePerKg": 1.20,
    "VolumetricDivisor": 5000.0,
    "MinimumCharge": 6.00,
    "StandardMultiplier": 1.00,
    "ExpressMultiplier": 1.60,
    "SameDayMultiplier": 2.20
  },
  "AdminSeed": {
    "Enabled": true,
    "Email": "admin@parceldelivery.com",
    "Password": "Admin@123456",
    "FullName": "System Administrator",
    "PhoneNumber": "+1-800-555-0199",
    "SeedDemoAccounts": true
  }
}
